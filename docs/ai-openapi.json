{
  "openapi": "3.1.0",
  "info": {
    "title": "댕기온 산책 위험도 API",
    "description": "날씨 + 반려견 특성으로 산책 위험도(0~100)·등급·사유를 산출합니다.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/score": {
      "post": {
        "summary": "Score",
        "operationId": "score_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DogIn": {
        "properties": {
          "breed": {
            "type": "string",
            "title": "Breed",
            "default": "믹스"
          },
          "size": {
            "type": "string",
            "enum": [
              "소형",
              "중형",
              "대형"
            ],
            "title": "Size",
            "default": "중형"
          },
          "coat_type": {
            "type": "string",
            "enum": [
              "장모",
              "단모"
            ],
            "title": "Coat Type",
            "default": "단모"
          },
          "age_years": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Age Years",
            "default": 3
          },
          "weight": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Weight",
            "default": 10.0
          },
          "is_brachycephalic": {
            "type": "boolean",
            "title": "Is Brachycephalic",
            "default": false
          },
          "heat_tolerance": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Heat Tolerance",
            "default": 3
          },
          "cold_tolerance": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Cold Tolerance",
            "default": 3
          }
        },
        "type": "object",
        "title": "DogIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ScoreRequest": {
        "properties": {
          "dog": {
            "$ref": "#/components/schemas/DogIn"
          },
          "weather": {
            "$ref": "#/components/schemas/WeatherIn"
          }
        },
        "type": "object",
        "title": "ScoreRequest"
      },
      "ScoreResponse": {
        "properties": {
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "level": {
            "type": "string",
            "enum": [
              "안전",
              "주의",
              "위험"
            ],
            "title": "Level"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "top_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Top Reasons"
          }
        },
        "type": "object",
        "required": [
          "score",
          "level",
          "reasons",
          "top_reasons"
        ],
        "title": "ScoreResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WeatherIn": {
        "properties": {
          "temperature": {
            "type": "number",
            "maximum": 60.0,
            "minimum": -50.0,
            "title": "Temperature",
            "default": 20.0
          },
          "feels_like": {
            "type": "number",
            "maximum": 70.0,
            "minimum": -60.0,
            "title": "Feels Like",
            "default": 20.0
          },
          "humidity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Humidity",
            "default": 50
          },
          "wind_speed": {
            "type": "number",
            "maximum": 80.0,
            "minimum": 0.0,
            "title": "Wind Speed",
            "default": 2.0
          },
          "ground_temperature": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -50.0,
            "title": "Ground Temperature",
            "default": 25.0
          },
          "pm10": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Pm10",
            "default": 30
          },
          "pm25": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Pm25",
            "default": 15
          },
          "precipitation_type": {
            "type": "string",
            "enum": [
              "없음",
              "비",
              "비눈",
              "눈"
            ],
            "title": "Precipitation Type",
            "default": "없음"
          }
        },
        "type": "object",
        "title": "WeatherIn"
      }
    }
  }
}