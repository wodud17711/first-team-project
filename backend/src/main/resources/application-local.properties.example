# ===== Local DB 설정 템플릿 =====
# 사용법
# 1. 이 파일을 같은 폴더에 application-local.properties 라는 이름으로 복사
# 2. spring.datasource.password 를 본인 MySQL root 비밀번호로 변경
# 3. MySQL 에 daengion DB 가 없으면 먼저 생성:
#    mysql -u root -p -e "CREATE DATABASE daengion DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#
# application-local.properties 는 .gitignore 처리되어 커밋되지 않습니다 (개인 비밀번호 보호).

spring.datasource.url=jdbc:mysql://localhost:3306/daengion?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useUnicode=true&allowPublicKeyRetrieval=true&useSSL=false
spring.datasource.username=root
spring.datasource.password=changeme
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JWT 시크릿 (dev 키. 운영은 환경변수 JWT_SECRET 으로 주입)
# dev 키 값은 HANDOFF.md 또는 팀 리더에게 문의
jwt.secret=PASTE_DEV_JWT_SECRET_HERE

# Refresh Token 쿠키 Secure 플래그.
# 로컬 dev 는 HTTP 라서 false 필수. 안 그러면 브라우저가 쿠키를 박지 않아 /api/auth/refresh 가 항상 실패.
# 운영(application.properties)은 true 가 기본값.
app.cookie.secure=false
